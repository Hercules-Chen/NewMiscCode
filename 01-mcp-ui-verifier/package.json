{
  "name": "mcp-ui-verifier",
  "version": "0.1.0",
  "description": "MCP server + CLI that drives a real browser (Playwright) to verify web UIs and produce annotated screenshots and an HTML report (zh-TW / en).",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "mcp-ui-verifier": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo-server": "node demo/server.js",
    "demo": "node src/cli.js demo",
    "test": "node --test",
    "audit-text": "node scripts/audit-text.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "1.63.0",
    "zod": "^4.6.7"
  }
}
