{
  "name": "passkeys-webauthn",
  "version": "0.1.0",
  "private": true,
  "description": "Passwordless login with Passkeys (WebAuthn) - Node + SQLite + SimpleWebAuthn, with CDP virtual-authenticator tests",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "volta": {
    "node": "22.23.4"
  },
  "scripts": {
    "build": "node scripts/build-client.js",
    "start": "node src/cli.js",
    "dev": "node src/cli.js --debug",
    "test": "node scripts/build-client.js && node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:unit": "node --test test/unit.test.js",
    "test:e2e": "node scripts/build-client.js && node --test test/e2e.test.js",
    "audit": "node ../tools/audit-text.mjs ."
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "esbuild": "0.28.2"
  }
}
