{
  "name": "pwa-offline-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first PWA (field inspection notes) with hand-written Service Worker, IndexedDB outbox, Background Sync, idempotency keys and conflict handling. Node + built-in node:sqlite.",
  "type": "module",
  "engines": {
    "node": ">=22.13 <25"
  },
  "volta": {
    "node": "22.23.4"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/cli.js",
    "dev": "node --disable-warning=ExperimentalWarning src/cli.js --debug",
    "icons": "node scripts/gen-icons.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/server.test.js test/e2e.test.js",
    "test:unit": "node --disable-warning=ExperimentalWarning --test test/server.test.js",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test test/e2e.test.js",
    "audit": "node ../tools/audit-text.mjs ."
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "license": "MIT"
}
